@agent: investigator
@mode: react
@tools: find_files, read_file, read_outline, search, reflect, done
@budget: 15000 tokens, 20 steps
@sgr_interval: 3
@llm: temperature=0
@data:
  diff_summary: string — from:pr_context.diff_summary
  existing_comments: string — from:pr_context.existing_comments
  commits: string — from:pr_context.commits
  focus: string — high-level concern to investigate (from lead)
@summary: Focused code reviewer. Receives a high-level concern,
  investigates with tools, uses SGR to track reasoning, returns
  findings with evidence.
