# Copy to .env and fill in your values, then: source .env

# ── LLM ───────────────────────────────────────────────────────────────────────

# OpenAI (default — leave api_url empty in config.local.yaml)
OPENAI_API_KEY=sk-...

# DeepSeek (set api_url: "https://api.deepseek.com/v1" in config.local.yaml)
# DEEPSEEK_API_KEY=sk-...

# Any other OpenAI-compatible provider
# MY_LLM_API_KEY=...

# ── Bitbucket Server ──────────────────────────────────────────────────────────

# Bearer token — required for --pr-url
BITBUCKET_SERVER_BEARER_TOKEN=...

# Custom CA bundle — needed when Bitbucket uses a private/self-signed cert
# REQUESTS_CA_BUNDLE=/path/to/ca.pem

# mTLS client certificate (PEM)
# BITBUCKET_SERVER_CLIENT_CERT=/path/to/client.pem
