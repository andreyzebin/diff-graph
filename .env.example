# Copy to .env and fill in your values, then: source .env

# ── Python ────────────────────────────────────────────────────────────────────

# Force UTF-8 mode (fixes Windows cp1251 issues)
export PYTHONUTF8=1

# ── LLM ───────────────────────────────────────────────────────────────────────

# Provider profiles live in ~/repos/.llm_creds.toml (see
# .llm_creds.toml.example). The env vars below are referenced from that
# file via ${VAR}, so secrets stay in the shell env.

# OpenAI (default — leave api_url empty in config.local.yaml)
export OPENAI_API_KEY=sk-...

# DeepSeek
# export DEEPSEEK_API_KEY=sk-...

# Cloud.ru Qwen endpoints — separate keys per deployment
# export CLOUD_RU_QWEN3_API_KEY=...      # foundation-models.api.cloud.ru
# export CLOUD_RU_QWEN3_6_API_KEY=...    # modelrun.inference.cloud.ru

# Any other OpenAI-compatible provider
# export MY_LLM_API_KEY=...

# CA bundle for LLM endpoint (corporate proxy/self-signed)
# export LLM_CA_BUNDLE=/path/to/llm-ca.pem

# Some corporate LLM endpoints sit on cloud.ru / *.ru and must NOT go via
# the local SOCKS/HTTP proxy. Make sure these stay unset (or in NO_PROXY)
# before invoking the agent or the benchmark, otherwise OpenAI requests
# get routed through 127.0.0.1:* and fail with APIConnectionError.
# unset all_proxy ALL_PROXY http_proxy HTTP_PROXY https_proxy HTTPS_PROXY

# ── Bitbucket Server ──────────────────────────────────────────────────────────

# Bearer token — required for --pr-url (API + git on Linux)
export BITBUCKET_SERVER_BEARER_TOKEN=...

# Custom CA bundle — needed when Bitbucket uses a private/self-signed cert
# export REQUESTS_CA_BUNDLE=/path/to/ca.pem

# mTLS client certificate (PEM)
# export BITBUCKET_SERVER_CLIENT_CERT=/path/to/client.pem

# ── Git auth ──────────────────────────────────────────────────────────────────

# Git clone method: "header" (default, Linux) or "ssh" (Windows/SSH keys)
# export DIFFGRAPH_GIT_AUTH=ssh

# Bitbucket Server SSH port (default 7999)
# export BITBUCKET_SSH_PORT=7999

# ── Docker build (optional, used by: source .env && docker build ...) ────────

# Corporate CA certs directory (copied into docker/certs/ at build time)
# export BUILD_CERTS_DIR=/etc/pki/ca-trust/extracted/pem

# Corporate Docker registry prefix (must end with /)
# export DOCKER_REGISTRY=osc.corp.com/docker.io/

# Corporate APT mirror (base URL, codename auto-detected)
# export APT_MIRROR_URL=http://mirror.corp.com/repo/debian/debian_yandex
# export APT_MIRROR_TOKEN=your-token

# Corporate PyPI mirror
# export PYPI_MIRROR_URL=https://mirror.corp.com/repo/pypi/simple
# export PYPI_MIRROR_TOKEN=...
