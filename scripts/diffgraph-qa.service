[Unit]
# DiffGraph QA server: the FastAPI app in tracing/server. Serves the
# QA UI + API (/qa/*, /api/qa/*), the per-run trace viewer (/, /runs/*),
# AND runs the WorkerSupervisor that spawns bench-task workers. One
# process, all of it — the trace viewer is just a subset of what this
# serves, hence the rename from diffgraph-trace.
Description=DiffGraph QA Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__INSTALL_DIR__

# Load .env (supports "export KEY=value" lines). TRACE_BASE_PATH optional for reverse proxy.
ExecStart=/bin/bash -lc 'set -a && source .env && exec .venv/bin/python -m tracing.server'

Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=diffgraph-qa

[Install]
WantedBy=multi-user.target
